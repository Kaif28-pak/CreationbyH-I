{
  "buildCommand": "node scripts/build-events.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/config.yml", "destination": "/admin/config.yml" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/events/:slug", "destination": "/event-detail.html?slug=:slug" },
    { "source": "/api/event-categories/:slug", "destination": "/api/event-categories?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
